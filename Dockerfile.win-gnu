# syntax=docker/dockerfile:1.7

# INSTANT CONTAINER INIT + FULL TOOLCHAIN READY
# 
# Everything pre-built in image → container starts instantly with tools ready
#
# Stage 1: Toolchain (mingw, rust, cargo) - STATIC, never changes
# Stage 2: Dependencies pre-compiled - STATIC, only changes with Cargo.toml
# Stage 3: Runtime with all tools available - INSTANT init
#
# Result:
# - Container init: INSTANT (0 setup overhead)
# - Tools ready: mingw, rust, cargo, all dependencies pre-compiled
# - Build/dev work: happens INSIDE container instantly
# - No re-downloading, no compilation on init
#
# REQUIRED: DOCKER_BUILDKIT=1

# ============ STAGE 1: Build toolchain (cached forever - static) ============
FROM rust:1-bookworm@sha256:9676d0547a259997add8f5924eb6b959c589ed39055338e23b99aba7958d6d31 AS toolchain-builder

# Install all build tools - STATIC layer, cached forever
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    pkg-config \
    binutils \
    build-essential \
    && rm -rf /var/lib/apt/lists/

ENV RUSTFLAGS=""

# ============ STAGE 2: Pre-compile ALL dependencies (cached until Cargo.toml changes) ============
FROM toolchain-builder AS deps-precompiled

WORKDIR /workspace

# Copy manifests - triggers rebuild only when Cargo.toml changes
COPY Cargo.toml Cargo.lock* ./

# Dummy build to pre-compile all dependencies
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    cargo build --release --target x86_64-pc-windows-gnu 2>&1 | tail -5

# ============ STAGE 3: Runtime (all tools ready, instant init) ============
FROM deps-precompiled AS runtime

# Copy entire project source code (no build yet)
COPY . /workspace/

WORKDIR /workspace

# Setup environment
ENV CARGO_TARGET_DIR=/workspace/target
ENV RUSTFLAGS=""
ENV PATH="/usr/local/bin:$PATH"

# Print available tools
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["echo '=== Development Environment Ready ===' && echo 'Tools available: rust, cargo, gcc, g++' && echo && echo 'Build inside container:' && echo '  cargo build' && echo '  cargo build --release' && echo && /bin/bash"]


